{% extends 'base.html.twig' %}

{% block title %}Hello AccessController!{% endblock %}

{% block body %}
<!DOCTYPE html>
<html>
<head>
    <title>Accès protégé</title>
    <meta charset="UTF-8">
</head>
<body>
    <h1>Ce site est en construction</h1>
    <p>Veuillez entrer le mot de passe pour y accéder.</p>

    {% if error %}
        <p style="color: red">{{ error }}</p>
    {% endif %}

    <form method="post">
        <input type="password" name="password" placeholder="Mot de passe" required />
        <button type="submit">Entrer</button>
    </form>
</body>
</html>
{% endblock %}
